{
  "name": "vue-echarts-v3",
  "version": "3.0.0",
  "description": "Vue.js 3 component wrapper for Apache ECharts",
  "author": "xLsDg <xlsdg@qq.com> (https://xlsdg.org/)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "echarts",
    "vue-echarts",
    "vue-echarts-v3",
    "chart",
    "visualization",
    "typescript"
  ],
  "homepage": "https://github.com/xlsdg/vue-echarts-v3",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlsdg/vue-echarts-v3.git"
  },
  "bugs": {
    "url": "https://github.com/xlsdg/vue-echarts-v3/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "browser": "./dist/index.umd.js",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lite": {
      "types": "./dist/types/lite.d.ts",
      "import": "./dist/lite.js",
      "require": "./dist/lite.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "npm run type-check && vite build",
    "type-check": "tsc --noEmit",
    "type-check:demo": "tsc -p tsconfig.demo.json --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json --noEmit",
    "type-check:all": "npm run type-check && npm run type-check:demo && npm run type-check:test",
    "preview": "vite preview --config demo/vite.config.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"demo/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "prepublishOnly": "npm run build && npm run test:coverage"
  },
  "peerDependencies": {
    "echarts": "^6.x",
    "vue": "^3.x"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.17.1",
    "echarts": "^6.x",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.8",
    "vue": "^3.x",
    "vue-tsc": "^3.1.3"
  }
}
